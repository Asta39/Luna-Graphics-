{
  "name": "luna-graphics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@tailwindcss/forms": "^0.5.7",
    "@testing-library/jest-dom": "^5.15.1",
    "@testing-library/react": "^11.2.7",
    "@testing-library/user-event": "^12.8.3",
    "axios": "^1.8.4",
    "d3": "^7.9.0",
    "date-fns": "^4.1.0",
    "dotenv": "^16.0.1",
    "framer-motion": "^10.16.4",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.484.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^2.0.5",
    "react-hook-form": "^7.55.0",
    "react-router-dom": "6.30.4",
    "react-router-hash-link": "^2.4.3",
    "recharts": "^2.15.2",
    "tailwindcss-animate": "^1.0.7",
    "tailwindcss-elevation": "^2.0.0",
    "tailwindcss-fluid-type": "^2.0.7"
  },
  "scripts": {
    "generate-sitemap": "node scripts/generate-sitemap.js",
    "ping-google": "node scripts/ping-google.js",
    "start": "vite",
    "build": "npm run generate-sitemap && npm run build:vite && npm run prerender",
    "prerender": "node scripts/prerender.js",
    "serve": "vite preview",
    "deploy": "npm run build && npm run ping-google",
    "build:vite": "vite build --sourcemap",
    "puppeteer:install": "npx puppeteer browsers install chrome",
    "validate:links": "node scripts/validate-links.js",
    "validate:seo": "node scripts/validate-seo.js",
    "build:smoke": "npm run generate-sitemap && npm run build:vite && PRERENDER_LIMIT=10 npm run prerender"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/typography": "^0.5.16",
    "@vitejs/plugin-react": "5.1.4",
    "autoprefixer": "10.4.22",
    "express": "^5.2.1",
    "postcss": "8.5.15",
    "puppeteer": "^24.40.0",
    "tailwindcss": "3.4.6",
    "vite": "6.4.3",
    "vite-tsconfig-paths": "3.6.0"
  }
}
